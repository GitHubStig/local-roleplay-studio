{
  "workspace": [
    "./server",
    "./web"
  ],
  "nodeModulesDir": "auto",
  "tasks": {
    "dev:server": "cd server && deno task dev",
    "dev:web": "cd web && deno task dev",
    "dev": {
      "description": "Run the Deno server and the Vite dev server together",
      "dependencies": [
        "dev:server",
        "dev:web"
      ]
    },
    "test:server": "cd server && deno task test",
    "test:web": "cd web && deno task test",
    "test": {
      "description": "Run the server's tests and the web app's together",
      "dependencies": [
        "test:server",
        "test:web"
      ]
    },
    "build": "cd web && deno task build",
    "check": "cd server && deno check . && cd ../web && deno task typecheck"
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "lineWidth": 100,
    "exclude": ["**/*.md", "docs/bench/", "web/index.html", "web/export.html", "web/public/"]
  }
}
