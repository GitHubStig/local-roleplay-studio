{
  "_note": "FLUX.2 Klein 4B (the distilled model), from ComfyUI's template image_flux2_klein_text_to_image, its 'Distilled' half (4 steps, CFG 1 with a zeroed negative, euler, Flux2Scheduler), in API format. $names are filled in by server/images/comfyui/workflow.ts. The picture comes back over the WebSocket (SaveImageWebsocket), so ComfyUI writes no file.",
  "unet": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "$unet", "weight_dtype": "default" }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "$clip", "type": "flux2", "device": "default" }
  },
  "vae": { "class_type": "VAELoader", "inputs": { "vae_name": "$vae" } },
  "text": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["clip", 0], "text": "$prompt" }
  },
  "negative": { "class_type": "ConditioningZeroOut", "inputs": { "conditioning": ["text", 0] } },
  "guider": {
    "class_type": "CFGGuider",
    "inputs": {
      "model": ["unet", 0],
      "positive": ["text", 0],
      "negative": ["negative", 0],
      "cfg": "$cfg"
    }
  },
  "sampler": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "euler" } },
  "sigmas": {
    "class_type": "Flux2Scheduler",
    "inputs": { "steps": "$steps", "width": "$width", "height": "$height" }
  },
  "noise": { "class_type": "RandomNoise", "inputs": { "noise_seed": "$seed" } },
  "latent": {
    "class_type": "EmptyFlux2LatentImage",
    "inputs": { "width": "$width", "height": "$height", "batch_size": 1 }
  },
  "sample": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["noise", 0],
      "guider": ["guider", 0],
      "sampler": ["sampler", 0],
      "sigmas": ["sigmas", 0],
      "latent_image": ["latent", 0]
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["sample", 0], "vae": ["vae", 0] }
  },
  "save": { "class_type": "SaveImageWebsocket", "inputs": { "images": ["decode", 0] } }
}
