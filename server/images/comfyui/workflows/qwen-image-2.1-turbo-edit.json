{
  "_note": "Qwen-Image 2.1 Turbo editing a picture (ADR 0021), from ComfyUI's template image_qwen_image_2_1_turbo_image_edit (8 steps on the template's fixed sigmas, so $steps isn't used; CFG 1, euler; QwenImage21Cache; the reference at its own size, resolution 0), without its prompt enhancer, on Qwen-Image 2.1 Turbo's own files. Otherwise as qwen-image-2.1-edit.json: the picture is the reference, the painted area the latent's noise mask, and the picture is pasted back outside it (ImageCompositeMasked). With nothing painted, comfyui.ts drops mask, encode, masked and composite, and the whole picture is repainted. $names are filled in by server/images/comfyui/comfyui.ts. Attention is Comfy Kitchen's int8 (ModelAttentionBackend), as in qwen-image-2.1-edit.json.",
  "unet": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "$unet", "weight_dtype": "default" }
  },
  "attention": {
    "class_type": "ModelAttentionBackend",
    "inputs": { "model": ["unet", 0], "attention": "comfy kitchen attention" }
  },
  "cache": {
    "class_type": "QwenImage21Cache",
    "inputs": { "model": ["attention", 0], "device": "auto", "dtype": "default" }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "$clip", "type": "qwen_image", "device": "default" }
  },
  "vae": { "class_type": "VAELoader", "inputs": { "vae_name": "$vae" } },
  "image": { "class_type": "LoadImage", "inputs": { "image": "$image" } },
  "mask": { "class_type": "LoadImageMask", "inputs": { "image": "$mask", "channel": "red" } },
  "conditioning": {
    "class_type": "TextEncodeQwenImage21",
    "inputs": {
      "clip": ["clip", 0],
      "prompt": "$prompt",
      "negative_prompt": "",
      "resolution": 0,
      "vae": ["vae", 0],
      "images.image_1": ["image", 0]
    }
  },
  "encode": { "class_type": "VAEEncode", "inputs": { "pixels": ["image", 0], "vae": ["vae", 0] } },
  "masked": {
    "class_type": "SetLatentNoiseMask",
    "inputs": { "samples": ["encode", 0], "mask": ["mask", 0] }
  },
  "guider": {
    "class_type": "CFGGuider",
    "inputs": {
      "model": ["cache", 0],
      "positive": ["conditioning", 0],
      "negative": ["conditioning", 1],
      "cfg": "$cfg"
    }
  },
  "select": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "euler" } },
  "sigmas": {
    "class_type": "ManualSigmas",
    "inputs": {
      "sigmas": "1.0, 0.978453, 0.95418, 0.926626, 0.89508, 0.845148, 0.704534, 0.414568, 0"
    }
  },
  "noise": { "class_type": "RandomNoise", "inputs": { "noise_seed": "$seed" } },
  "sampler": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["noise", 0],
      "guider": ["guider", 0],
      "sampler": ["select", 0],
      "sigmas": ["sigmas", 0],
      "latent_image": ["masked", 0]
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["sampler", 0], "vae": ["vae", 0] }
  },
  "rgb": { "class_type": "SplitImageWithAlpha", "inputs": { "image": ["decode", 0] } },
  "composite": {
    "class_type": "ImageCompositeMasked",
    "inputs": {
      "destination": ["image", 0],
      "source": ["rgb", 0],
      "mask": ["mask", 0],
      "x": 0,
      "y": 0,
      "resize_source": false
    }
  },
  "save": { "class_type": "SaveImageWebsocket", "inputs": { "images": ["composite", 0] } }
}
