{
  "_note": "FIBO 2.0 Turbo text-to-image (the Edit Turbo checkpoint without a reference image), using ComfyUI's native TextEncodeFibo2 node, 4 steps and CFG 1. The encoder accepts the app's prose prompt; its optional reference images are not used here. $names are filled in by server/images/comfyui/workflow.ts. SaveImageWebsocket keeps the output in the app rather than ComfyUI's output folder.",
  "unet": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "$unet", "weight_dtype": "default" }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "$clip", "type": "fibo2", "device": "default" }
  },
  "vae": { "class_type": "VAELoader", "inputs": { "vae_name": "$vae" } },
  "conditioning": {
    "class_type": "TextEncodeFibo2",
    "inputs": {
      "clip": ["clip", 0],
      "prompt": "$prompt",
      "negative_prompt": "",
      "width": "$width",
      "height": "$height",
      "batch_size": 1
    }
  },
  "sampler": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["unet", 0],
      "seed": "$seed",
      "steps": "$steps",
      "cfg": "$cfg",
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["conditioning", 0],
      "negative": ["conditioning", 1],
      "latent_image": ["conditioning", 2],
      "denoise": 1
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["sampler", 0], "vae": ["vae", 0] }
  },
  "save": { "class_type": "SaveImageWebsocket", "inputs": { "images": ["decode", 0] } }
}
