{
  "_note": "Ming-Image 0.1 Design, from ComfyUI's template image_ming_image_01_design_t2i (12 steps, no CFG (BasicGuider), euler, simple, ModelSamplingFlux at the picture's size, Comfy Kitchen's int8 attention, which falls back to PyTorch's where it can't run, as on a Mac), in API format, without its prompt enhancer (Qwen3.8-27B; the Text Model already writes the full scene). $names are filled in by server/images/comfyui/workflow.ts. It decodes RGBA, so it's sent as RGB (SplitImageWithAlpha), as qwen-image-2.1.json is.",
  "unet": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "$unet", "weight_dtype": "default" }
  },
  "attention": {
    "class_type": "ModelAttentionBackend",
    "inputs": { "model": ["unet", 0], "attention": "comfy kitchen attention" }
  },
  "shift": {
    "class_type": "ModelSamplingFlux",
    "inputs": {
      "model": ["attention", 0],
      "max_shift": 1.15,
      "base_shift": 0.5,
      "width": "$width",
      "height": "$height"
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "$clip", "type": "qwen_image", "device": "default" }
  },
  "vae": { "class_type": "VAELoader", "inputs": { "vae_name": "$vae" } },
  "text": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["clip", 0], "text": "$prompt" }
  },
  "guider": {
    "class_type": "BasicGuider",
    "inputs": { "model": ["shift", 0], "conditioning": ["text", 0] }
  },
  "sampler": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "euler" } },
  "sigmas": {
    "class_type": "BasicScheduler",
    "inputs": { "model": ["shift", 0], "scheduler": "simple", "steps": "$steps", "denoise": 1 }
  },
  "noise": { "class_type": "RandomNoise", "inputs": { "noise_seed": "$seed" } },
  "latent": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": "$width", "height": "$height", "batch_size": 1 }
  },
  "sample": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["noise", 0],
      "guider": ["guider", 0],
      "sampler": ["sampler", 0],
      "sigmas": ["sigmas", 0],
      "latent_image": ["latent", 0]
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["sample", 0], "vae": ["vae", 0] }
  },
  "rgb": { "class_type": "SplitImageWithAlpha", "inputs": { "image": ["decode", 0] } },
  "save": { "class_type": "SaveImageWebsocket", "inputs": { "images": ["rgb", 0] } }
}
